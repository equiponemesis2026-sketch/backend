PORT=8080
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGO_DB_NAME=nemesis
JWT_SECRET=changeme-to-a-strong-random-secret
JWT_EXPIRY=24h
STRIPE_SECRET_KEY=sk_test_<your_stripe_secret_key>
STRIPE_WEBHOOK_SECRET=whsec_<your_webhook_signing_secret>
STRIPE_PRICE_PRO=price_<pro_tier_price_id>
STRIPE_PRICE_FAMILIAR=price_<familiar_tier_price_id>
# Orígenes permitidos para CORS (separados por coma). ANTES DE PRODUCCIÓN:
# fijar los dominios reales del dashboard web (p.ej. https://dashboard.miapp.com)
# en lugar del wildcard, tanto aquí como en OriginPatterns del WebSocket.
CORS_ALLOWED_ORIGINS=*
FIREBASE_SERVICE_ACCOUNT=<base64_json_o_ruta_al_json_de_cuenta_de_servicio>

# --- Módulo de audio en tiempo real y análisis vocal ---
# Tamaño máximo de un fragmento de audio (bytes).
AUDIO_MAX_CHUNK_BYTES=1048576
# Umbral a partir del cual un stress_score marca distress (0.0 a 1.0).
STRESS_CRITICAL_THRESHOLD=0.85
# Umbral intermedio para separar tensión leve de estrés.
STRESS_EMOTIONAL_THRESHOLD=0.6
# Número de workers del pool de análisis asíncrono.
AI_WORKER_COUNT=4
# URL del microservicio de IA (nemesis-ai). En docker-compose: http://nemesis-ai:8000
AI_ANALYZER_URL=http://localhost:8000
# Timeout de cada llamada HTTP al microservicio de IA.
AI_ANALYZER_TIMEOUT=10s

